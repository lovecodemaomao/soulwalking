APP_ENV=development
# 生产环境填入逗号分隔的真实域名，例如 soulwalking-agent.onrender.com,walk.example.com
APP_ALLOWED_HOSTS=
# 同源页面不需要 CORS；仅当另一个网页域名要调用本 API 时填入完整 https URL。
APP_ALLOWED_ORIGINS=
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60
PYTHON_BASE_IMAGE=python:3.12-slim
DATABASE_PATH=data/soulwalking.db
CHROMA_PATH=data/chroma
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=data/hf-cache
SHORT_TERM_MEMORY_HOURS=12
# heuristic/policy 为低延迟确定性策略；面试演示 LLM 解析/Tool Calling 时可改为 llm
CONSTRAINT_PARSING_MODE=heuristic
TOOL_SELECTION_MODE=policy
WEATHER_CACHE_TTL_SECONDS=300
ROUTE_CACHE_TTL_SECONDS=600
AMAP_WEB_ROUTE_MAX_CONCURRENCY=2
AMAP_WEB_ROUTE_RETRIES=3

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

AMAP_API_KEY=
AMAP_MCP_URL=
MCP_ENABLED=false

# 高德 JavaScript API 2.0（绑定服务：Web端）
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
